{
  "name": "mempool-backend",
  "version": "3.3.1",
  "description": "Bitcoin mempool visualizer and blockchain explorer backend",
  "license": "GNU Affero General Public License v3.0",
  "homepage": "https://explorer.bitcoinuniverse.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mempool/mempool"
  },
  "bugs": {
    "url": "https://github.com/mempool/mempool/issues"
  },
  "keywords": [
    "bitcoin",
    "mempool",
    "blockchain",
    "explorer",
    "liquid",
    "lightning"
  ],
  "main": "index.ts",
  "scripts": {
    "tsc": "tsc -p tsconfig.build.json",
    "build": "npm run tsc && npm run create-resources",
    "clean": "node scripts/clean-build.mjs",
    "create-resources": "node scripts/create-resources.mjs",
    "package": "./npm_package.sh",
    "package-rm-build-deps": "./npm_package_rm_build_deps.sh",
    "preinstall": "cd ../rust/gbt && npm run build-release && npm run to-backend",
    "start": "node --max-old-space-size=2048 dist/index.js",
    "start-production": "node --max-old-space-size=16384 dist/index.js",
    "reindex-updated-pools": "npm run start-production --update-pools",
    "reindex-all-blocks": "npm run start-production --update-pools --reindex-blocks",
    "test": "jest --coverage",
    "test:ci": "jest --coverage --ci",
    "test:integration": "jest --config=jest.integration.config.ts --runInBand --forceExit",
    "test:with-db": "bash ./scripts/test-with-db.sh",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "prettier": "prettier --write \"src/**/*.{js,ts}\""
  },
  "dependencies": {
    "@bitcoinuniverse/ecosystem-contracts": "file:vendor/bitcoinuniverse-ecosystem-contracts-1.2.0.tgz",
    "@mempool/electrum-client": "1.1.9",
    "@types/node": "^18.15.3",
    "axios": "^1.20.0",
    "bitcoinjs-lib": "~6.1.3",
    "crypto-js": "~4.2.0",
    "express": "~4.22.1",
    "maxmind": "~4.3.11",
    "mysql2": "~3.24.2",
    "redis": "^4.7.0",
    "rust-gbt": "file:./rust-gbt",
    "socks-proxy-agent": "~7.0.0",
    "typescript": "~4.9.3",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/compression": "^1.7.2",
    "@types/crypto-js": "^4.1.1",
    "@types/express": "^4.17.17",
    "@types/jest": "^30.0.0",
    "@types/ws": "~8.18.1",
    "@typescript-eslint/eslint-plugin": "^5.55.0",
    "@typescript-eslint/parser": "^5.55.0",
    "eslint": "^8.36.0",
    "eslint-config-prettier": "^8.8.0",
    "eslint-plugin-local-rules": "^3.0.2",
    "jest": "^30.0.0",
    "prettier": "^3.0.0",
    "ts-jest": "^29.4.5",
    "ts-node": "^10.9.1"
  },
  "overrides": {
    "js-yaml": "^4.1.1",
    "glob": "^11.1.0"
  }
}
